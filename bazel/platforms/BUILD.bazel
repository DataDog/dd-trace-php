constraint_setting(name = "libc")

constraint_value(
    name = "glibc",
    constraint_setting = ":libc",
)

constraint_value(
    name = "musl",
    constraint_setting = ":libc",
)

constraint_setting(name = "sanitizer")

constraint_value(
    name = "normal",
    constraint_setting = ":sanitizer",
)

constraint_value(
    name = "asan",
    constraint_setting = ":sanitizer",
)

platform(
    name = "linux_amd64_glibc",
    constraint_values = [
        ":glibc",
        ":normal",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@rules_rs//rs/platforms/constraints:glibc",
    ],
)

platform(
    name = "linux_arm64_glibc",
    constraint_values = [
        ":glibc",
        ":normal",
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "@rules_rs//rs/platforms/constraints:glibc",
    ],
)

platform(
    name = "linux_amd64_musl",
    constraint_values = [
        ":musl",
        ":normal",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@rules_rs//rs/platforms/constraints:musl",
    ],
)

platform(
    name = "linux_arm64_musl",
    constraint_values = [
        ":musl",
        ":normal",
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "@rules_rs//rs/platforms/constraints:musl",
    ],
)

platform(
    name = "asan_linux_amd64_glibc",
    constraint_values = [
        ":asan",
        ":glibc",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@rules_rs//rs/platforms/constraints:glibc",
    ],
)

platform(
    name = "asan_linux_arm64_glibc",
    constraint_values = [
        ":asan",
        ":glibc",
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "@rules_rs//rs/platforms/constraints:glibc",
    ],
)

# Compilation initially executes on the shared Linux amd64 workers. These
# property names match the Remote Execution platform contract used by the
# shared Buildbarn queue.
platform(
    name = "linux_amd64_exec",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        "ISA": "x86-64",
        "OSFamily": "Linux",
    },
)
