package(default_visibility = ["//visibility:public"])

constraint_setting(
    name = "libc",
    default_constraint_value = ":glibc",
)

constraint_value(
    name = "glibc",
    constraint_setting = ":libc",
)

constraint_value(
    name = "musl",
    constraint_setting = ":libc",
)

constraint_setting(
    name = "sanitizer",
    default_constraint_value = ":normal",
)

constraint_setting(name = "configuration_role")

constraint_value(
    name = "target_configuration",
    constraint_setting = ":configuration_role",
)

constraint_value(
    name = "exec_configuration",
    constraint_setting = ":configuration_role",
)

config_setting(
    name = "rust_exec_aarch64_linux_gnu",
    constraint_values = [
        ":exec_configuration",
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "@rules_rs//rs/platforms/constraints:glibc",
    ],
)

config_setting(
    name = "rust_exec_x86_64_linux_gnu",
    constraint_values = [
        ":exec_configuration",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@rules_rs//rs/platforms/constraints:glibc",
    ],
)

constraint_setting(name = "runtime_profile")

constraint_value(
    name = "profile_release",
    constraint_setting = ":runtime_profile",
)

constraint_value(
    name = "profile_debug",
    constraint_setting = ":runtime_profile",
)

constraint_value(
    name = "profile_asan",
    constraint_setting = ":runtime_profile",
)

constraint_value(
    name = "normal",
    constraint_setting = ":sanitizer",
)

constraint_value(
    name = "asan",
    constraint_setting = ":sanitizer",
)

platform(
    name = "linux_amd64_glibc",
    constraint_values = [
        ":glibc",
        ":normal",
        ":profile_release",
        ":target_configuration",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@rules_rs//rs/platforms/constraints:glibc",
    ],
)

platform(
    name = "linux_arm64_glibc",
    constraint_values = [
        ":glibc",
        ":normal",
        ":profile_release",
        ":target_configuration",
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "@rules_rs//rs/platforms/constraints:glibc",
    ],
)

platform(
    name = "linux_amd64_musl",
    constraint_values = [
        ":musl",
        ":normal",
        ":profile_release",
        ":target_configuration",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@rules_rs//rs/platforms/constraints:musl",
    ],
)

platform(
    name = "linux_arm64_musl",
    constraint_values = [
        ":musl",
        ":normal",
        ":profile_release",
        ":target_configuration",
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "@rules_rs//rs/platforms/constraints:musl",
    ],
)

platform(
    name = "asan_linux_amd64_glibc",
    constraint_values = [
        ":asan",
        ":profile_asan",
        ":glibc",
        ":target_configuration",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@rules_rs//rs/platforms/constraints:glibc",
    ],
)

platform(
    name = "asan_linux_arm64_glibc",
    constraint_values = [
        ":asan",
        ":profile_asan",
        ":glibc",
        ":target_configuration",
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "@rules_rs//rs/platforms/constraints:glibc",
    ],
)

# Compilation initially executes on the shared Linux amd64 workers. These
# property names match the Remote Execution platform contract used by the
# shared Buildbarn queue.
platform(
    name = "linux_amd64_exec",
    constraint_values = [
        ":glibc",
        ":normal",
        ":exec_configuration",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@rules_rs//rs/platforms/constraints:glibc",
    ],
    exec_properties = {
        "ISA": "x86-64",
        "OSFamily": "Linux",
    },
)

platform(
    name = "linux_arm64_exec",
    constraint_values = [
        ":glibc",
        ":normal",
        ":exec_configuration",
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "@rules_rs//rs/platforms/constraints:glibc",
    ],
    exec_properties = {
        "ISA": "arm-a64",
        "OSFamily": "Linux",
    },
)
