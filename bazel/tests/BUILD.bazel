load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@rules_itest//:itest.bzl", "itest_service", "port", "service_test")
load(":phpt.bzl", "PHPT_CASES", "php_phpt_tests")

package(default_visibility = ["//visibility:public"])

_php = "@php_exec_bookworm_amd64//:php"
_loader = "@php_exec_bookworm_amd64//:loader"
_lib_root = "@php_exec_bookworm_amd64//:lib_root"
_extension = "//bazel/products/tracer:ddtrace_fat_amd64_glibc_php85_binary"
_curl = "@target_curl_centos7_amd64//:library"
_runtime = [
    "@php_exec_bookworm_amd64//:all",
    "@target_curl_centos7_amd64//:all",
    _loader,
    _lib_root,
    _php,
    _curl,
    _extension,
]
_runtime_args = [
    "$(rootpath %s)" % _loader,
    "$(rootpath %s)" % _lib_root,
    "$(rootpath %s)" % _php,
    "$(rootpath %s)" % _extension,
    "$(rootpath %s)" % _curl,
]
_platform = ["@platforms//os:linux", "@platforms//cpu:x86_64", "//bazel/platforms:glibc"]

php_phpt_tests(_runtime, _runtime_args, _platform)

py_binary(
    name = "_phpt_php",
    srcs = ["phpt_php.py"],
    main = "phpt_php.py",
    target_compatible_with = _platform,
)

py_test(
    name = "phpt_all",
    srcs = ["phpt_all_test.py", "php_test_runtime.py"],
    main = "phpt_all_test.py",
    args = _runtime_args + [
        "$(rootpath @php_8_5_bookworm//:run-tests.php)",
        "$(rootpath :_phpt_php)",
        "$(rootpath //tests/ext:extension_disabled.phpt)",
    ],
    data = _runtime + [
        "@php_8_5_bookworm//:run-tests.php",
        ":_phpt_php",
        "//tests/ext:extension_disabled.phpt",
        "//tests/ext:phpt_data",
    ],
    size = "enormous",
    timeout = "eternal",
    tags = ["manual"],
    target_compatible_with = _platform,
)

py_binary(
    name = "_http_server",
    srcs = ["http_server.py", "php_test_runtime.py"],
    main = "http_server.py",
    data = _runtime + ["http_endpoint.php"],
    target_compatible_with = _platform,
)

itest_service(
    name = "http_service",
    exe = ":_http_server",
    data = _runtime + ["http_endpoint.php"],
    args = _runtime_args + ["$(rootpath :http_endpoint.php)", port(":http_service")],
    autoassign_port = True,
    http_health_check_address = "http://127.0.0.1:" + port(":http_service") + "/health",
    tags = ["manual"],
)

py_test(
    name = "_http_client",
    srcs = ["http_client_test.py"],
    main = "http_client_test.py",
    tags = ["manual"],
    target_compatible_with = _platform,
)

service_test(
    name = "http_extension_test",
    env = {
        "HTTP_PROXY": "",
        "HTTPS_PROXY": "",
        "ALL_PROXY": "",
        "NO_PROXY": "127.0.0.1,localhost",
    },
    services = [":http_service"],
    test = ":_http_client",
    target_compatible_with = _platform,
)

test_suite(
    name = "php_tests",
    tests = [":phpt_" + name for name in PHPT_CASES] + [":http_extension_test"],
)
