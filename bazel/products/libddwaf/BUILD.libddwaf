load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["include/ddwaf.h"])

cc_library(
    name = "libddwaf",
    srcs = [
        "src/action_mapper.cpp",
        "src/attribute_collector.cpp",
        "src/builder/action_mapper_builder.cpp",
        "src/builder/checksum_builder.cpp",
        "src/builder/matcher_builder.cpp",
        "src/builder/module_builder.cpp",
        "src/builder/processor_builder.cpp",
        "src/builder/ruleset_builder.cpp",
        "src/checksum/luhn_checksum.cpp",
        "src/clock.cpp",
        "src/condition/cmdi_detector.cpp",
        "src/condition/exists.cpp",
        "src/condition/lfi_detector.cpp",
        "src/condition/negated_scalar_condition.cpp",
        "src/condition/scalar_condition.cpp",
        "src/condition/shi_common.cpp",
        "src/condition/shi_detector.cpp",
        "src/condition/sqli_detector.cpp",
        "src/condition/ssrf_detector.cpp",
        "src/configuration/actions_parser.cpp",
        "src/configuration/common/expression_parser.cpp",
        "src/configuration/common/matcher_parser.cpp",
        "src/configuration/common/raw_configuration.cpp",
        "src/configuration/common/reference_parser.cpp",
        "src/configuration/common/transformer_parser.cpp",
        "src/configuration/configuration_manager.cpp",
        "src/configuration/data_parser.cpp",
        "src/configuration/exclusion_parser.cpp",
        "src/configuration/processor_override_parser.cpp",
        "src/configuration/processor_parser.cpp",
        "src/configuration/rule_override_parser.cpp",
        "src/configuration/rule_parser.cpp",
        "src/configuration/scanner_parser.cpp",
        "src/context_allocator.cpp",
        "src/dynamic_string.cpp",
        "src/evaluation_engine.cpp",
        "src/exclusion/input_filter.cpp",
        "src/exclusion/object_filter.cpp",
        "src/exclusion/rule_filter.cpp",
        "src/expression.cpp",
        "src/glibc-compat/math.c",
        "src/glibc-compat/time64.c",
        "src/interface.cpp",
        "src/ip_utils.cpp",
        "src/iterator.cpp",
        "src/json_utils.cpp",
        "src/log.cpp",
        "src/matcher/exact_match.cpp",
        "src/matcher/hidden_ascii_match.cpp",
        "src/matcher/ip_match.cpp",
        "src/matcher/is_sqli.cpp",
        "src/matcher/is_xss.cpp",
        "src/matcher/phrase_match.cpp",
        "src/matcher/regex_match.cpp",
        "src/matcher/regex_match_with_checksum.cpp",
        "src/module.cpp",
        "src/object_store.cpp",
        "src/obfuscator.cpp",
        "src/platform.cpp",
        "src/processor/extract_schema.cpp",
        "src/processor/fingerprint.cpp",
        "src/processor/jwt_decode.cpp",
        "src/processor/uri_parse.cpp",
        "src/rule.cpp",
        "src/ruleset_info.cpp",
        "src/semver.cpp",
        "src/serializer.cpp",
        "src/sha256.cpp",
        "src/tokenizer/generic_sql.cpp",
        "src/tokenizer/mysql.cpp",
        "src/tokenizer/pgsql.cpp",
        "src/tokenizer/shell.cpp",
        "src/tokenizer/sql_base.cpp",
        "src/tokenizer/sqlite.cpp",
        "src/transformer/base64_decode.cpp",
        "src/transformer/base64_encode.cpp",
        "src/transformer/compress_whitespace.cpp",
        "src/transformer/css_decode.cpp",
        "src/transformer/html_entity_decode.cpp",
        "src/transformer/js_decode.cpp",
        "src/transformer/lowercase.cpp",
        "src/transformer/manager.cpp",
        "src/transformer/normalize_path.cpp",
        "src/transformer/remove_comments.cpp",
        "src/transformer/remove_nulls.cpp",
        "src/transformer/shell_unescape.cpp",
        "src/transformer/unicode_normalize.cpp",
        "src/transformer/url_basename.cpp",
        "src/transformer/url_decode.cpp",
        "src/transformer/url_path.cpp",
        "src/transformer/url_querystring.cpp",
        "src/uri_utils.cpp",
        "src/utf8.cpp",
        "src/utils.cpp",
        "src/uuid.cpp",
        "src/vendor/fmt/format.cc",
        "src/vendor/libinjection/src/libinjection_html5.c",
        "src/vendor/libinjection/src/libinjection_sqli.c",
        "src/vendor/libinjection/src/libinjection_xss.c",
        "src/vendor/libinjection/src/xss.c",
        "src/vendor/lua-aho-corasick/ac.cxx",
        "src/vendor/lua-aho-corasick/ac_fast.cxx",
        "src/vendor/lua-aho-corasick/ac_slow.cxx",
        "src/vendor/radixlib/radixlib.c",
        "src/vendor/re2/bitstate.cc",
        "src/vendor/re2/compile.cc",
        "src/vendor/re2/dfa.cc",
        "src/vendor/re2/nfa.cc",
        "src/vendor/re2/onepass.cc",
        "src/vendor/re2/parse.cc",
        "src/vendor/re2/perl_groups.cc",
        "src/vendor/re2/prog.cc",
        "src/vendor/re2/re2.cc",
        "src/vendor/re2/regexp.cc",
        "src/vendor/re2/simplify.cc",
        "src/vendor/re2/tostring.cc",
        "src/vendor/re2/unicode_casefold.cc",
        "src/vendor/re2/unicode_groups.cc",
        "src/vendor/re2/util/rune.cc",
        "src/vendor/re2/util/strutil.cc",
        "src/vendor/utf8proc/utf8proc.c",
    ],
    hdrs = glob([
        "include/**/*.h",
        "src/**/*.h",
        "src/**/*.hpp",
        "src/vendor/**/*.h",
    ]) + ["src/vendor/utf8proc/utf8proc_data.c"],
    copts = [
        "-Wall",
        "-Wextra",
        "-Wno-narrowing",
    ],
    defines = [
        "FMT_OPTIMIZE_SIZE=2",
        "LIBDDWAF_VECTORIZED_TRANSFORMERS=1",
        "UTF8PROC_STATIC=1",
    ],
    includes = [
        "include",
        "src",
        "src/vendor",
        "src/vendor/libinjection/src",
        "src/vendor/lua-aho-corasick",
        "src/vendor/radixlib",
        "src/vendor/re2",
        "src/vendor/utf8proc",
    ],
    linkopts = [
        "-ldl",
        "-lm",
        "-lpthread",
        "-lrt",
    ],
    deps = [
        "@dd_trace_php//bazel/products/libddwaf:version_header",
        "@rapidjson_source//:rapidjson",
    ],
)
