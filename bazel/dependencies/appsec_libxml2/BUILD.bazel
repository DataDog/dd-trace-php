# ASan variants are bound to real matching PHP SDK profiles.  They are
# separate from the reviewed normal NTS/ZTS archives and require the declared
# LLVM ASan DSO at native-run time.
appsec_libxml2(
    name = "_x86_64_glibc_nts_asan",
    php = "//bazel/php:php_8_5_amd64_glibc_bookworm_nts_asan",
    runtime = "//bazel/dependencies/llvm_runtimes:x86_64_glibc",
)

appsec_libxml2(
    name = "_x86_64_glibc_zts_asan",
    php = "//bazel/php:php_8_5_amd64_glibc_bookworm_debug_zts_asan",
    runtime = "//bazel/dependencies/llvm_runtimes:x86_64_glibc",
)

appsec_libxml2_asan_native_probe(
    name = "_x86_64_glibc_nts_asan_native",
    elf_architecture = "x86_64",
    library = ":_x86_64_glibc_nts_asan",
    machine = "x86_64",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

appsec_libxml2_asan_native_probe(
    name = "_x86_64_glibc_zts_asan_native",
    elf_architecture = "x86_64",
    library = ":_x86_64_glibc_zts_asan",
    machine = "x86_64",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

configured_target(
    name = "x86_64_glibc_nts_asan",
    actual = ":_x86_64_glibc_nts_asan",
    matrix_platform = "asan-linux-amd64-glibc",
)

configured_target(
    name = "x86_64_glibc_zts_asan",
    actual = ":_x86_64_glibc_zts_asan",
    matrix_platform = "asan-linux-amd64-glibc",
)

configured_target(
    name = "x86_64_glibc_nts_asan_native_smoke",
    actual = ":_x86_64_glibc_nts_asan_native",
    matrix_platform = "asan-linux-amd64-glibc",
)

configured_target(
    name = "x86_64_glibc_zts_asan_native_smoke",
    actual = ":_x86_64_glibc_zts_asan_native",
    matrix_platform = "asan-linux-amd64-glibc",
)

# ARM archives cross-build locally. Their native runners are constrained to
# an ARM Linux executor and are intentionally not run until ARM execution is
# approved.
