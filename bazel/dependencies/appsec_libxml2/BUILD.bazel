load("//bazel/platforms:transitions.bzl", "configured_target")
load(":defs.bzl", "appsec_libxml2", "appsec_libxml2_asan_native_probe", "appsec_libxml2_native_probe")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "build-libxml2.sh",
    "allocator-smoke.c",
    "run-asan-allocator-smoke.sh",
])

# Instances are intentionally declared by the PHP-specific AppSec product:
# the `php` attribute is the sole source of the NTS/ZTS thread setting.

appsec_libxml2(
    name = "_x86_64_glibc_nts",
    php = "//bazel/php:php_8_5_amd64_glibc_bookworm_nts",
    runtime = "//bazel/dependencies/llvm_runtimes:x86_64_glibc",
)

appsec_libxml2(
    name = "_x86_64_glibc_zts",
    php = "//bazel/php:php_8_5_amd64_glibc_bookworm_zts",
    runtime = "//bazel/dependencies/llvm_runtimes:x86_64_glibc",
)

configured_target(
    name = "x86_64_glibc_nts",
    actual = ":_x86_64_glibc_nts",
    matrix_platform = "linux-amd64-glibc",
)

appsec_libxml2_native_probe(
    name = "_x86_64_glibc_nts_native",
    busybox = "@exec_tools_alpine322_x86_64//:root/bin/busybox.static",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    library = ":_x86_64_glibc_nts",
)

appsec_libxml2_native_probe(
    name = "_x86_64_glibc_zts_native",
    busybox = "@exec_tools_alpine322_x86_64//:root/bin/busybox.static",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    library = ":_x86_64_glibc_zts",
)

configured_target(
    name = "x86_64_glibc_nts_native_smoke",
    actual = ":_x86_64_glibc_nts_native",
    matrix_platform = "linux-amd64-glibc",
)

configured_target(
    name = "x86_64_glibc_zts_native_smoke",
    actual = ":_x86_64_glibc_zts_native",
    matrix_platform = "linux-amd64-glibc",
)

