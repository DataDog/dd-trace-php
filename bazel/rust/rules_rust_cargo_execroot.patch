+_PROC_SELF_CWD_PREFIX = "/proc/self/cwd/"
+
+# Bazel's C++ APIs may return tools rooted at /proc/self/cwd. That spelling is
+# valid in a direct action, but cargo_build_script_runner changes directory to
+# the crate before invoking the build script. Convert it to the runner's
+# execroot placeholder before that chdir happens.
+def _cargo_tool_path(path):
+    if path.startswith(_PROC_SELF_CWD_PREFIX):
+        return "${{pwd}}/{}".format(path[len(_PROC_SELF_CWD_PREFIX):])
+    if _should_prefix_pwd(path):
+        return "${{pwd}}/{}".format(path)
+    return path
+
+def _pwd_flags_proc_self_cwd(args):
+    """Replace /proc/self/cwd execroot aliases embedded in compiler flags."""
+    return [arg.replace(_PROC_SELF_CWD_PREFIX, "${pwd}/") for arg in args]
+
+def _cargo_linker_env(linker_env):
+    """Make declared execution-tool roots stable across the runner chdir."""
+    result = dict(linker_env)
+    for key, value in linker_env.items():
+        if key == "PATH":
+            result[key] = ":".join([_cargo_tool_path(path) for path in value.split(":")])
+        elif key.startswith("HERMETIC_") and key.endswith("_ROOT"):
+            result[key] = _cargo_tool_path(value)
+    return result
+
 def _should_prefix_pwd(path):
