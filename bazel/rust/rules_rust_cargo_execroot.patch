+fn resolve_tool_path(exec_root: &Path, tool_path: &OsStr) -> PathBuf {
+    let exec_root_str = exec_root.to_str().expect("exec_root not in utf8");
+    let expanded = tool_path.to_string_lossy().replace("${pwd}", exec_root_str);
+    let expanded = Path::new(&expanded);
+
+    // C++ toolchains may use /proc/self/cwd as an execroot alias. The runner
+    // invokes build.rs from CARGO_MANIFEST_DIR, so retain the action's original
+    // execroot instead of allowing the alias to follow the child process cwd.
+    if let Ok(relative) = expanded.strip_prefix("/proc/self/cwd") {
+        return exec_root.join(relative);
+    }
+    exec_root.join(expanded)
+}
