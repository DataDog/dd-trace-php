+
+def _proc_macro_compiler_transition_impl(settings, _attr):
+    # Proc macros are compiler plugins and must use the target rustc's metadata
+    # and proc_macro ABI. Preserve stable for ordinary builds and dated nightly
+    # for ASan, while moving the artifact to the host platform and removing all
+    # target product/sanitizer flags.
+    return {
+        "//command_line_option:platforms": [settings["//command_line_option:host_platform"]],
+        _PROC_MACRO_COMPILER_SETTING: True,
+        _RUST_CHANNEL_SETTING: settings[_RUST_CHANNEL_SETTING],
+        _RUST_EXTRA_FLAGS_SETTING: [],
+        _RUST_LTO_SETTING: "unspecified",
+    }
+
+_proc_macro_compiler_transition = transition(
+    implementation = _proc_macro_compiler_transition_impl,
+    inputs = [
+        "//command_line_option:host_platform",
+        _RUST_CHANNEL_SETTING,
+    ],
+    outputs = [
+        "//command_line_option:platforms",
+        _PROC_MACRO_COMPILER_SETTING,
+        _RUST_CHANNEL_SETTING,
+        _RUST_EXTRA_FLAGS_SETTING,
