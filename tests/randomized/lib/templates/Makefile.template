DURATION := 30s

test.scenario.%:
	@make -C $(*) run DURATION=$(DURATION)

shell.scenario.%:
	@make -C $(*) shell

# Listing the base services as a prerequisite of test would let make --jobs
# start the scenarios alongside them, before their shared network exists.
test:
	@bash ../lib/run-base-docker-compose.sh
	@$(MAKE) --no-print-directory run_scenarios; ret=$$?; \
		bash ../lib/run-base-docker-compose.sh shutdown; \
		exit $$ret

run_scenarios: {{test_targets}}

start_base_docker:
	@bash ../lib/run-base-docker-compose.sh

shutdown_base_docker:
	@bash ../lib/run-base-docker-compose.sh shutdown

# keep this line to avoid whitespace errors with generated files
