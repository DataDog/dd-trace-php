+    fn resource_limit(&mut self, message: &'static str) -> XMLError {
+        if !self.resources.failed {
+            fatal_error!(self, ResourceLimit, message);
+        }
+        self.resources.failed = true;
+        XMLError::XMLParseError(ParseError::ResourceLimit)
+    }
+
+    /// Charge before allocating/copying a replacement or applying a default.
+    /// Internal replacement sources never increase the input allowance.
+    pub(crate) fn charge_expansion(&mut self, extra: usize) -> Result<(), XMLError> {
+        let document = self.source_stack.first().unwrap_or(&self.source);
+        let allowed = document
+            .consumed()
+            .saturating_mul(MAX_AMPLIFICATION)
+            .min(MAX_EXPANSION_WORK);
+        let cost = self
+            .resources
+            .expansion
+            .saturating_add(extra)
+            .saturating_add(ENTITY_FIXED_COST);
+        if self.resources.failed || cost == usize::MAX || cost > allowed {
+            return Err(self.resource_limit("Maximum XML expansion work exceeded"));
+        }
+        self.resources.expansion = cost;
+        Ok(())
+    }
+
+    pub(crate) fn charge_internal_entity(&mut self, name: &str) -> Result<(), XMLError> {
+        let length = match self.entities.get(name) {
+            Some(
+                EntityDecl::InternalGeneralEntity {
+                    replacement_text, ..
+                }
+                | EntityDecl::InternalParameterEntity {
+                    replacement_text, ..
+                },
+            ) => replacement_text.len(),
+            _ => return Ok(()),
+        };
+        // InputSource::from_content copies its argument, so check before it.
+        if self.source_stack.len() >= MAX_ENTITY_DEPTH {
+            return Err(self.resource_limit("Maximum XML entity nesting depth exceeded"));
+        }
+        self.charge_expansion(length.saturating_add(name.len()))
+    }
