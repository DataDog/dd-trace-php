+            return Err(self.resource_limit("Maximum XML element nesting depth exceeded"));
+        }
+        self.resources.element_depth += 1;
+        Ok(())
+    }
+
+    pub(crate) fn leave_element(&mut self) {
+        self.resources.element_depth = self.resources.element_depth.saturating_sub(1);
+    }
