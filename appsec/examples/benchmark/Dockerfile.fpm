FROM php:8.5-fpm

RUN apt-get update && \
    apt-get install -y --no-install-recommends nginx && \
    rm -rf /var/lib/apt/lists/*

# Use the non-ZTS package matching PHP's architecture and module API.
COPY packages/ /tmp/dd-packages/

RUN arch="$(uname -m)" && \
    case "$arch" in \
        aarch64|arm64) package_arch="aarch64" ;; \
        x86_64|amd64) package_arch="x86_64" ;; \
        *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac && \
    api="$(php -i | sed -n 's/^PHP Extension Build => API\([0-9][0-9]*\),.*/\1/p')" && \
    pkg="$(ls /tmp/dd-packages/dd-library-php-*-"${package_arch}"-linux-gnu-"${api}".tar.gz 2>/dev/null | head -1)" && \
    test -n "$pkg" && \
    php /tmp/dd-packages/datadog-setup.php --php-bin=all --file="$pkg"

COPY nginx.conf /etc/nginx/nginx.conf
COPY php-fpm-benchmark.conf /usr/local/etc/php-fpm.d/zz-benchmark.conf
COPY www/ /app/public/

CMD ["sh", "-c", "php-fpm -D && exec nginx -g 'daemon off;'"]
