filegroup(
    name = "tracer_php81_sources",
    srcs = [
        "tracer/handlers_fiber.c",
        ":tracer_php80_sources",
    ],
)

# PHP 8.2 through PHP 8.5 share the same source selection. Keep separate
# public groups so each configured archive records its intended PHP minor.
filegroup(
    name = "tracer_php82plus_sources",
    srcs = [
        "tracer/handlers_curl.c",
        "tracer/handlers_fiber.c",
        "tracer/hook/uhook_attributes.c",
