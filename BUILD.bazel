ddtrace_rust_targets()

cc_library(
    name = "tracer_native_headers",
    hdrs = glob([
        "components/**/*.h",
        "components-rs/**/*.h",
        "ext/**/*.h",
        "src/dogstatsd/**/*.h",
        "tracer/**/*.h",
        "zend_abstract_interface/**/*.h",
    ]),
    includes = [
        "src/dogstatsd",
        "tracer/vendor",
        "zend_abstract_interface",
    ],
    strip_include_prefix = "/",
)

