filegroup(
    name = "stage1",
    srcs = [
        "//bazel/php:matrix.json",
        "//bazel/probes:exec_rust_toolchain_probe",
        "//bazel/stages:bootstrap_manifest",
    ],
)

filegroup(
    name = "php_all",
    srcs = ["//bazel/php:php_all"],
)

unavailable_stage(
    name = "extensions_all",
    reason = "the full tracer, profiler, AppSec, and helper product set is unfinished",
)

unavailable_stage(
    name = "bundles_all",
    reason = "complete deterministic product and SSI bundles are unfinished",
