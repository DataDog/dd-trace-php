# PHP 7.0-7.2 include the bundled hrtime compatibility implementation.
filegroup(
    name = "tracer_php70_sources",
    srcs = [
        "ext/zend_hrtime.c",
        "tracer/handlers_curl_php7.c",
        "zend_abstract_interface/interceptor/php7/interceptor.c",
        "zend_abstract_interface/interceptor/php7/resolver.c",
        "zend_abstract_interface/sandbox/php7/sandbox.c",
        ":tracer_common_sources",
    ],
)

filegroup(
    name = "tracer_php71_sources",
    srcs = [":tracer_php70_sources"],
)

filegroup(
    name = "tracer_php72_sources",
    srcs = [":tracer_php70_sources"],
)

# PHP 7.3-7.4 use the PHP 7 ZAI sources without zend_hrtime.c.
filegroup(
    name = "tracer_php73_sources",
    srcs = [
        "tracer/handlers_curl_php7.c",
        "zend_abstract_interface/interceptor/php7/interceptor.c",
        "zend_abstract_interface/interceptor/php7/resolver.c",
        "zend_abstract_interface/sandbox/php7/sandbox.c",
        ":tracer_common_sources",
    ],
)

filegroup(
