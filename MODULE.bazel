    patches = ["//bazel/rust:rules_rust_cargo_execroot.patch"],
    strip = 1,
)
use_repo(rules_rust, "rules_rust")

# Keep stable compilation and ASan/nightly compilation as distinct toolchain
# repositories. Ordinary compilation and build scripts select stable. ASan
# target configurations select nightly with source-built std; their proc macros
# use an uninstrumented normal-platform toolchain from the same nightly so the
# compiler metadata and proc_macro ABI match.
rust_toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rust_toolchains.toolchain(
    # rules_rs imports this canonical repository name for its own tools.
    name = "default_rust_toolchains",
    edition = "2021",
    use_rust_redist = False,
    version = "1.87.0",
)
rust_toolchains.toolchain(
    name = "rust_asan_toolchains",
    edition = "2021",
    rustc_src_direct = True,
    use_rust_redist = False,
    version = "nightly/2025-06-13",
)
use_repo(
    rust_toolchains,
    "default_rust_toolchains",
    "rust_asan_toolchains",
